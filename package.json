{
  "name": "buzz-context-mcp",
  "version": "0.1.0-alpha.2",
  "private": true,
  "description": "Independent read-only Buzz context MCP server",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "bin": {
    "buzz-context-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "AGENTS.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs",
    "SUPPORTED_VERSION.json",
    "scripts/prepare-local.mjs"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && tsx --test test/*.test.ts",
    "lint": "eslint src test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "start": "node dist/cli.js serve",
    "prepare-local": "node scripts/prepare-local.mjs",
    "setup": "node dist/cli.js configure"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@napi-rs/keyring": "2.1.1",
    "nostr-tools": "2.25.2",
    "pdfjs-dist": "6.4.299",
    "zod": "3.25.76",
    "fflate": "0.8.3",
    "fast-xml-parser": "5.11.2",
    "csv-parse": "7.0.3",
    "@scure/base": "2.0.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "eslint": "10.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "tsx": "4.23.15"
  }
}
